# Copy this file to ".env" and fill it in only on the family computer.
# NEVER paste the key into messages, e-mails or shared files.
ANTHROPIC_API_KEY=
# Model with vision. Check the identifier at https://platform.claude.com/docs/en/models/overview
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3001
DATA_DIR=./data

# Browser: by default the app opens in Microsoft Edge (natural Canadian French voice).
# To use the Windows default browser, remove the # from the line below.
# MELINA_BROWSER=default

# Game art («Art du jeu» tab in the parent area). The Claude API does not generate images:
# generation uses an image provider with its own key.
#   IMAGE_PROVIDER=openai  -> OpenAI image API (needs IMAGE_API_KEY)
#   IMAGE_PROVIDER=mock    -> test images, free of charge, only to try out the screen
#   (empty)                -> generation turned off; the game uses the built-in art
IMAGE_PROVIDER=
IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-2.5-sunburst
# IMAGE_QUALITY=medium
